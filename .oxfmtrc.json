{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "src/assets/styles/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-ssr",
    "release",
    "*.zip",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}
