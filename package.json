{
  "name": "zimmail-plus",
  "version": "1.10.3",
  "description": "Nhận thông báo, xem nhanh và quản lý email tức thì mà không cần mở trang Zimbra Mail.",
  "keywords": [
    "chrome-extension",
    "mail-plus",
    "notifier",
    "zimbra"
  ],
  "homepage": "https://github.com/lamnx-dev/zimmail-plus#readme",
  "bugs": {
    "url": "https://github.com/lamnx-dev/zimmail-plus/issues"
  },
  "license": "MIT",
  "author": "lamnx-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamnx-dev/zimmail-plus.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@crxjs/vite-plugin": "^2.7.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  }
}
